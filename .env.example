# Public browser URL of the FastAPI deployment. Leave empty for same-origin reverse proxy.
VITE_API_BASE_URL=https://your-api-host.example.com
# Comma-separated frontend origins allowed by the API.
CORS_ORIGINS=https://your-frontend-host.example.com,http://localhost:5174
# PostgreSQL connection string used for durable replay/trading sessions.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/delta_replay
# Session lifetime before the scheduled cleanup job removes inactive sessions.
SESSION_RETENTION_HOURS=168
# Server-side GitHub dataset storage. Configure these on Render, never as VITE_* variables.
DATASET_GITHUB_REPO=Sandeep119public/delta-replay
DATASET_GITHUB_BRANCH=datasets
DATASET_GITHUB_TOKEN=replace-with-fine-grained-contents-write-token
DATASET_PUBLISH_SECRET=replace-with-long-random-operator-secret
DATASET_CACHE_TTL_SECONDS=60
