{
  "name": "delta-replay",
  "version": "0.1.0",
  "description": "Historical market replay application - Phase 1 of Delta Replay",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:architecture": "node --test tests/architecture/boundaries.test.js",
    "test:architecture:graph": "node scripts/check-architecture.mjs",
    "test:ui-contracts": "node --test tests/architecture/ui-contracts.test.js",
    "check": "npm run test:architecture:graph && npm run test:architecture && npm run test:ui-contracts && npm run test && npm run build",
    "vibe": "npm run check",
    "dev:host": "vite --host 0.0.0.0",
    "vibe:quick": "npm run test:ui-contracts && npm run test:architecture",
    "vibe:full": "npm run check",
    "vibe:dev": "npm run dev:host"
  },
  "dependencies": {
    "lightweight-charts": "4.2.3"
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "packageManager": "npm@10.8.2+sha512.c7f008c8f6f8f1da943400199748a0f7ea8cb8df75469668dc26f6fb3ba26df87e2884a5ebe91557292d0f3db7d0929cdb4f14910c3032ac81fb"
}
